<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fpp.Cli</RootNamespace>
    <AssemblyName>fpp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fpp.Compiler/Fpp.Compiler.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native/*.c" CopyToOutputDirectory="PreserveNewest" LinkBase="native" />
  </ItemGroup>
</Project>
