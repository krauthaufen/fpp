<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fpp.Cli</RootNamespace>
    <AssemblyName>fpp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Fpp.Compiler/Fpp.Compiler.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native/*.c" CopyToOutputDirectory="PreserveNewest" LinkBase="native" />
    <!-- the fpprt reactors ship beside the binary: mmc (the default build's
         collector — real pinning) and semi (the shakeout collector, picked
         via FPP_REACTOR) -->
    <None Include="../../tests/tooling/gc/fpprt_reactor_mmc.wasm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/tooling/gc/fpprt_reactor.wasm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
