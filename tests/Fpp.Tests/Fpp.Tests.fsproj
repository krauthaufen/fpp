<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LexerTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="QueryTests.fs" />
    <Compile Include="WorkspaceTests.fs" />
    <Compile Include="ResolveTests.fs" />
    <Compile Include="InferTests.fs" />
    <Compile Include="ProjectTests.fs" />
    <Compile Include="LowerTests.fs" />
    <Compile Include="EmitTests.fs" />
    <Compile Include="OracleTests.fs" />
    <Compile Include="LibraryTests.fs" />
    <Compile Include="ClassTests.fs" />
    <Compile Include="ProjectTests2.fs" />
    <Compile Include="PluginTests.fs" />
    <Compile Include="LinkTests.fs" />
    <Compile Include="FfiTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fpp.Compiler/Fpp.Compiler.fsproj" />
    <ProjectReference Include="../../src/Fpp.Lsp/Fpp.Lsp.fsproj" />
  </ItemGroup>

  <!-- `dotnet test` drives the VSTest target. Expecto has no VSTest
       adapter that works here, and without one `dotnet test` runs NOTHING
       and reports success — a green CI over an untested tree. Overriding the
       target runs the real suite and propagates its exit code. -->
  <Target Name="VSTest" DependsOnTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; $(VSTestTestCaseFilter)" />
  </Target>

</Project>
