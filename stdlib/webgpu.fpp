let WrapGPUTextureView (h : int) : GPUTextureView = GPUTextureView h
let WrapGPUExternalTexture (h : int) : GPUExternalTexture = GPUExternalTexture h
let WrapGPUSampler (h : int) : GPUSampler = GPUSampler h
